# Environment Variables — Copy this file to .env and fill in the values

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND (apps/web) — prefix VITE_ to expose to Vite
# ─────────────────────────────────────────────────────────────────────────────

# Google Maps API Key (used in embed iframe src)
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCwhlJKJiSztyGhz8ORWtd7TvPFe4y00DE

# Backend API base URL (empty = same origin, set for production)
VITE_API_URL=http://localhost:4000

# ─────────────────────────────────────────────────────────────────────────────
# BACKEND (apps/api)
# ─────────────────────────────────────────────────────────────────────────────

# Server port
API_PORT=4000

# Frontend origin for CORS (comma-separated for multiple)
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL / SMTP (for contact form)
# ─────────────────────────────────────────────────────────────────────────────

# Sender address
EMAIL_FROM=noreply@simplemarketingideas.com

# Recipient address (where contact form emails are sent)
EMAIL_TO=info@simplemarketingideas.com

# SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
